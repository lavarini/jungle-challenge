# Local development values only. No real secrets.
WAGERD_ROLE=all
HTTP_ADDR=:8080
ADMIN_ADDR=:9090
HTTP_REQUEST_TIMEOUT=10s
DATABASE_URL=postgres://wager_app:app-dev-only@localhost:5432/wagering?sslmode=disable
MIGRATE_DATABASE_URL=postgres://wager_migrator:migrator-dev-only@localhost:5432/wagering?sslmode=disable
# DB_MAX_CONNS must be >= OUTBOX_PUBLISH_CONCURRENCY plus slack for HTTP, the
# consumer and the reference resolver when running the `all` role.
DB_MAX_CONNS=20
DB_LOCK_TIMEOUT=2s
DB_STATEMENT_TIMEOUT=5s
OIDC_ISSUER_URL=http://localhost:8081/realms/wagering
OIDC_DISCOVERY_URL=http://localhost:8081/realms/wagering
OIDC_AUDIENCE=wagering-api
OIDC_CLOCK_SKEW=30s
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WAGER_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_WAGER_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_SENDER_PROVIDERS=111111111111=provider-a,222222222222=provider-b
SQS_MAX_RECEIVES=5
SNS_EVENTS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:wallet-events.fifo
SHUTDOWN_TIMEOUT=25s
SHUTDOWN_READINESS_DELAY=0s
REFERENCE_TTL=24h
REFERENCE_BACKOFF_INITIAL=1s
REFERENCE_BACKOFF_MAX=5m
WORKER_POLL_INTERVAL=500ms
WORKER_LEASE=30s
WORKER_BATCH=50
OUTBOX_PUBLISH_CONCURRENCY=16
