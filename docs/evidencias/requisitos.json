  {"id": "sec.iam", "requisito": "Privilégio mínimo na AWS por papel de processo (ADR 0016)", "testes": ["TestIAMPolicyActionsMatchCode", "TestIAMPolicyHasNoWildcards", "TestIAMPolicyFilesCoverEveryRole"]}
