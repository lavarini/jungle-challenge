  {"id": "13.5", "requisito": "Queda do consumidor após commit e antes da remoção", "testes": ["TestConsumerCrashAfterCommitIsRedeliveredWithoutDoubleDebit", "TestConsumerAppliesAMessageOnceEvenWhenRedelivered", "TestRedeliveredMessageIsAnsweredFromTheInbox"]},
  {"id": "13.6", "requisito": "Dois publishers disputando a outbox", "testes": ["TestTwoRelaysPublishEachWalletInCommitOrder", "TestExpiredClaimIsRepublishedWithTheSameEventID", "TestRelayCrashAfterPublishIsRepublishedWithTheSameEventID"]},
  {"id": "13.http-sqs", "requisito": "Mesma operação por HTTP e SQS", "testes": ["TestHTTPThenSQSForTheSameOperationDebitsOnce", "TestSameOperationViaHTTPAndSQSDebitsOnce", "TestFiftyMixedHTTPAndSQSDuplicates", "TestNewMessageForAnAppliedOperationIsAReplay"]},
  {"id": "2", "requisito": "Autenticação real e isolamento entre provedores", "testes": ["TestKeycloakTokensMapToPrincipals", "TestKeycloakExpiredTokenIsRejected", "TestTransactionReadsRespectProviderScope", "TestAuthorizationByRoute", "TestAuthorizationRefusalsHaveNoFinancialEffect", "TestExternalReadRefusesAnotherProvidersPath", "TestGetTransactionByIDScopesToProvider"]},
  {"id": "10", "requisito": "DLQ para mensagens inválidas e remetente não autorizado", "testes": ["TestConsumerDeadLettersUnauthorizedAndInvalidMessages", "TestTransientFailureAtMaxReceivesGoesToDLQAsRetriesExhausted", "TestSenderBoundToAnotherProviderIsRejected"]},
  {"id": "4", "requisito": "Lifecycle Fx e shutdown", "testes": ["TestFxLifecycleStartsServesAndStopsCleanly", "TestSIGTERMDrainsAndExitsCleanly"]},
  {"id": "9.rec", "requisito": "Reconciliação", "testes": ["TestReconciliationMatchesTheLedger", "TestReconcileReportsDifferenceAsStoredMinusCalculated"]},
