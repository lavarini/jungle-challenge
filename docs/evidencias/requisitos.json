  {"id": "3.transitoria", "requisito": "Indisponibilidade temporária do PostgreSQL ou do SQS sem efeito duplicado", "testes": ["TestClassify", "TestTransientFailureBacksOffAndReleasesTheRestOfItsGroup", "TestTransientFailureDuringShutdownIsReleasedWithoutCanceledInTheChain", "TestPublishTreatsConfigurationErrorsAsTransient"]},
